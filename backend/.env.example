# Copia este archivo como ".env" (NUNCA subas el .env real a GitHub)
# y arranca con: uvicorn app.main:app --env-file .env

# Dominio(s) exacto(s) del sitio en producción, separados por comas.
ALLOWED_ORIGINS=https://tu-dominio.com

# Carpeta donde se guardan los CSV con datos personales.
# Debe estar FUERA del código y del sitio público, p. ej. /var/lib/wftf
DATA_DIR=/var/lib/wftf

# Documentación automática de la API (/docs). Déjala en false en producción.
ENABLE_DOCS=false

# Máximo de envíos por IP en la ventana de tiempo indicada (segundos).
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Si el backend está detrás de un proxy (Nginx, Render, Railway...), arráncalo con:
#   uvicorn app.main:app --proxy-headers --forwarded-allow-ips="<IP del proxy>"
# para que el límite de envíos se aplique por usuario y no a todos a la vez.
